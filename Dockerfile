FROM node:24-bookworm AS build

WORKDIR /app
COPY .npmrc package.json ./
COPY generated ./generated
RUN npm install --ignore-scripts

COPY . .
ARG VITE_API_BASE_URL=__STAND_VITE_API_BASE_URL__
ARG VITE_STELLAR_NETWORK_PASSPHRASE=__STAND_VITE_STELLAR_NETWORK_PASSPHRASE__
ARG VITE_HORIZON_URL=__STAND_VITE_HORIZON_URL__
ARG VITE_SOROBAN_RPC_URL=__STAND_VITE_SOROBAN_RPC_URL__
ARG VITE_POOL_CONTRACT=__STAND_VITE_POOL_CONTRACT__
ARG VITE_PRIVATE_ADDRESS_REGISTRY_CONTRACT=__STAND_VITE_PRIVATE_ADDRESS_REGISTRY_CONTRACT__
ARG VITE_KYT_PASSAGE_REGISTRY_CONTRACT=__STAND_VITE_KYT_PASSAGE_REGISTRY_CONTRACT__
ARG VITE_APPLICATION_ID=__STAND_VITE_APPLICATION_ID__
ARG VITE_STELLAR_AUDIT_PUBLIC_KEY=__STAND_VITE_STELLAR_AUDIT_PUBLIC_KEY__
ARG VITE_PRICE_XLM=__STAND_VITE_PRICE_XLM__
ARG VITE_ZK_CONFIG_NONCE=__STAND_VITE_ZK_CONFIG_NONCE__
ARG VITE_ZK_ARTIFACT_BASE_URL=__STAND_VITE_ZK_ARTIFACT_BASE_URL__
ARG VITE_RELAY_API_ORIGIN=__STAND_VITE_RELAY_API_ORIGIN__
ARG VITE_PRIVATE_DATA_ORIGIN=__STAND_VITE_PRIVATE_DATA_ORIGIN__
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_STELLAR_NETWORK_PASSPHRASE=$VITE_STELLAR_NETWORK_PASSPHRASE
ENV VITE_HORIZON_URL=$VITE_HORIZON_URL
ENV VITE_SOROBAN_RPC_URL=$VITE_SOROBAN_RPC_URL
ENV VITE_POOL_CONTRACT=$VITE_POOL_CONTRACT
ENV VITE_PRIVATE_ADDRESS_REGISTRY_CONTRACT=$VITE_PRIVATE_ADDRESS_REGISTRY_CONTRACT
ENV VITE_KYT_PASSAGE_REGISTRY_CONTRACT=$VITE_KYT_PASSAGE_REGISTRY_CONTRACT
ENV VITE_APPLICATION_ID=$VITE_APPLICATION_ID
ENV VITE_STELLAR_AUDIT_PUBLIC_KEY=$VITE_STELLAR_AUDIT_PUBLIC_KEY
ENV VITE_PRICE_XLM=$VITE_PRICE_XLM
ENV VITE_ZK_CONFIG_NONCE=$VITE_ZK_CONFIG_NONCE
ENV VITE_ZK_ARTIFACT_BASE_URL=$VITE_ZK_ARTIFACT_BASE_URL
ENV VITE_RELAY_API_ORIGIN=$VITE_RELAY_API_ORIGIN
ENV VITE_PRIVATE_DATA_ORIGIN=$VITE_PRIVATE_DATA_ORIGIN
RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY docker/entrypoint.sh /entrypoint.sh
COPY --from=build /app/dist /usr/share/nginx/html
RUN chmod +x /entrypoint.sh
EXPOSE 80
ENTRYPOINT ["/entrypoint.sh"]
